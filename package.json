{
  "name": "food-platform-api",
  "version": "1.0.0",
  "description": "Food Platform Backend API — Task 1: foundation, auth (register/login), MySQL/Prisma",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:validate": "prisma validate",
    "test:setup": "node tests/setup-db.js",
    "pretest": "node tests/setup-db.js",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test --test-concurrency=1 tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mysql2": "^3.24.4",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
