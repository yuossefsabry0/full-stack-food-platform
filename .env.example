# Server
PORT=3000
NODE_ENV=development

# Database (MySQL via Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/food_platform"

# Dedicated test database (Task 9) — integration tests use this automatically
# and never touch development/production. The database name must contain
# "test" or the test setup refuses to run.
TEST_DATABASE_URL="mysql://root@127.0.0.1:3307/food_platform_test"

# Auth — Access Token (Task 1). Refresh Token workflow belongs to Task 2.
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"

# Auth — Refresh Token (Task 2). Separate secret + separate (longer) expiry.
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Password reset / OTP policy (Task 2)
OTP_EXPIRE_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_MAX_REQUESTS_PER_HOUR="5"
RESET_TOKEN_EXPIRE_MINUTES="15"

# Order pricing (Task 4) — Delivery Fee is configuration, never hard-coded.
DELIVERY_FEE="50"

# ADMIN seed (Task 7) — source-code/database creation only. There is no
# public create-admin endpoint. Override these in production.
ADMIN_NAME="Site Admin"
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin123!"

# Security layer (Task 8)
# Comma-separated allowed origins, or "*" to allow all.
CORS_ORIGIN="*"
# Trust proxy hops for real client IP (rate limiting): false | true | <n>.
TRUST_PROXY="false"
REQUEST_BODY_LIMIT="1mb"

# Operational logging (Task 8) — JSON lines inside the project.
LOG_LEVEL="debug"
LOG_FILE="logs/operational.log"

# Rate limiting tunables (Task 8): max requests per window in milliseconds.
RATE_LOGIN_MAX="20"
RATE_LOGIN_WINDOW_MS="900000"
RATE_REGISTER_MAX="20"
RATE_REGISTER_WINDOW_MS="3600000"
