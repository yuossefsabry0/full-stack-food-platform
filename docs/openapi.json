      }
    },
    "/api/delivery/orders/{id}/deliver": {
      "post": {
        "tags": ["DELIVERY"],
        "summary": "Mark delivered: OUT_FOR_DELIVERY to DELIVERED (DELIVERY)",
        "description": "Only the accepting courier while carrying the order. Moves it to previous orders.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 }, "description": "Order ID" }],
        "responses": {
          "200": { "description": "Order delivered" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Missing/invalid access token" },
          "403": { "description": "Non-DELIVERY role" },
          "404": { "description": "Order not found" },
          "409": { "description": "Not deliverable by me" }
        }
      }
    },
    "/api/delivery/orders/previous": {
      "get": {
        "tags": ["DELIVERY"],
