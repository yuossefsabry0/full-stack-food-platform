    "/api/admin/analytics": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Product sales + total sales from DELIVERED orders (ADMIN)",
        "description": "Units sold today/month/year, sales today/month/year, productRevenue (sum of line subtotals) + deliveryFees per period (productRevenue + deliveryFees equals the total), units for every product. Carts and undelivered orders never count. Optional ?dateBasis=created|delivered selects the bucketing date (default created); delivered buckets by deliveredAt and excludes records with null deliveredAt from the date buckets. Other values are 400 VALIDATION_ERROR.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "dateBasis", "in": "query", "schema": { "type": "string", "enum": ["created", "delivered"], "default": "created" } }
        ],
        "responses": {
          "200": { "description": "Analytics payload" },
          "401": { "description": "Missing/invalid access token" },
          "403": { "description": "Non-ADMIN role" }
        }
      }
    }
