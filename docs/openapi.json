      "get": {
        "tags": ["Admin"],
        "summary": "List CHEF/DELIVERY accounts (ADMIN)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
          { "name": "role", "in": "query", "schema": { "type": "string", "enum": ["CHEF", "DELIVERY"] } }
        ],
        "responses": {
          "200": { "description": "Staff + meta" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Missing/invalid access token" },
          "403": { "description": "Non-ADMIN role" }
        }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Create CHEF/DELIVERY account (ADMIN)",
        "description": "Role restricted to CHEF/DELIVERY by validation. Password hashed, public code allocated, immediately usable for login.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "username", "email", "password", "role"],
                "properties": {
                  "name": { "type": "string", "minLength": 2, "maxLength": 120 },
                  "username": { "type": "string", "minLength": 3, "maxLength": 60, "pattern": "^[a-zA-Z0-9._-]+$" },
                  "email": { "type": "string", "format": "email", "maxLength": 190 },
                  "password": { "type": "string", "minLength": 8, "maxLength": 128 },
                  "role": { "type": "string", "enum": ["CHEF", "DELIVERY"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Staff account created" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Missing/invalid access token" },
          "403": { "description": "Non-ADMIN role" },
          "409": { "description": "Username/email taken" }
        }
      }
    },
