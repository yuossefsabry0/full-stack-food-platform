{
  "openapi": "3.0.3",
  "info": {
    "title": "Food Platform API",
    "version": "1.0.0",
    "description": "JSON backend API for the food ordering platform (Tasks 1-9). All UI concepts are API routes + JSON responses for a future frontend. Interactive UI: /api/docs. Machine-readable: /api/docs.json."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "tags": [
    { "name": "System", "description": "Health and API documentation" },
    { "name": "Home", "description": "Authenticated home entrypoint" },
    { "name": "Authentication", "description": "Public auth: register, login, refresh, password recovery" },
    { "name": "Products", "description": "Public menu, details, search, pagination" },
    { "name": "Cart", "description": "BASIC cart (protected, BASIC role only)" },
    { "name": "Orders", "description": "BASIC checkout and order reads (protected, BASIC role only)" },
    { "name": "CHEF", "description": "Preparation workflow (protected, CHEF role only)" },
    { "name": "DELIVERY", "description": "Delivery workflow (protected, DELIVERY role only)" },
    { "name": "Admin", "description": "Dashboard, users, products, orders, staff (protected, ADMIN role only)" },
    { "name": "Analytics", "description": "DELIVERED-only sales statistics (protected, ADMIN role only)" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "Access token from login/refresh: Authorization: Bearer <accessToken>" }
    },
    "schemas": {
      "NavigationLink": {
        "type": "object",
        "required": ["rel", "method", "href", "label"],
        "properties": {
          "rel": { "type": "string", "example": "login" },
          "method": { "type": "string", "example": "POST" },
          "href": { "type": "string", "example": "/api/auth/login" },
          "label": { "type": "string", "example": "Log In" }
        }
      },
      "Navigation": {
        "type": "object",
        "required": ["links"],
        "properties": {
          "links": { "type": "array", "items": { "$ref": "#/components/schemas/NavigationLink" } },
          "next": { "$ref": "#/components/schemas/NavigationLink" }
        }
      },
      "FieldError": {
        "type": "object",
        "required": ["field", "message"],
        "properties": { "field": { "type": "string" }, "message": { "type": "string" } }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["success", "message", "code", "errors"],
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "code": { "type": "string", "example": "VALIDATION_ERROR" },
          "errors": { "type": "array", "nullable": true, "items": { "$ref": "#/components/schemas/FieldError" } },
          "navigation": { "$ref": "#/components/schemas/Navigation" }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "required": ["page", "limit", "total", "totalPages"],
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 10 },
          "total": { "type": "integer", "example": 42 },
          "totalPages": { "type": "integer", "example": 5 }
        }
      },
      "PublicUser": {
        "type": "object",
        "properties": {
          "userCode": { "type": "string", "description": "Public user ID (5+ digits), separate from the internal DB id", "example": "10000" },
          "name": { "type": "string" },
          "username": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string", "enum": ["BASIC", "CHEF", "DELIVERY", "ADMIN"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "MenuItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "Product ID used to link cart/order operations" },
          "name": { "type": "string" },
          "price": { "type": "number" },
          "image": { "type": "string", "nullable": true },
          "description": { "type": "string", "nullable": true },
          "detailsUrl": { "type": "string" }
        }
      },
      "ProductDetails": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "price": { "type": "number" },
          "image": { "type": "string", "nullable": true },
          "description": { "type": "string", "nullable": true },
          "isActive": { "type": "boolean" },
          "addToCart": { "type": "object", "properties": { "method": { "type": "string" }, "href": { "type": "string" }, "label": { "type": "string" } } }
        }
      },
      "CartItem": {
        "type": "object",
        "properties": {
          "productId": { "type": "integer" },
          "name": { "type": "string" },
          "price": { "type": "number" },
          "image": { "type": "string", "nullable": true },
          "quantity": { "type": "integer" },
          "lineTotal": { "type": "number", "description": "price x quantity" }
        }
      },
      "Cart": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "nullable": true },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/CartItem" } },
          "count": { "type": "integer" },
          "total": { "type": "number", "description": "Products total (backward compatible)" },
          "productsTotal": { "type": "number" },
          "deliveryFee": { "type": "number", "description": "From DELIVERY_FEE env configuration" },
          "totalAmount": { "type": "number", "description": "productsTotal + deliveryFee" }
        }
      },
      "OrderItemSnapshot": {
        "type": "object",
        "properties": {
          "productId": { "type": "integer", "nullable": true },
          "productName": { "type": "string", "description": "Snapshot at checkout; immune to later product edits" },
          "unitPrice": { "type": "number" },
          "quantity": { "type": "integer" },
          "subtotal": { "type": "number", "description": "unitPrice x quantity" }
        }
      },
      "DeliveryAddress": {
        "type": "object",
        "required": ["name", "address", "buildingNumber", "apartmentNumber", "streetName", "phoneNumber"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 120 },
          "address": { "type": "string", "minLength": 3, "maxLength": 255 },
          "buildingNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
          "apartmentNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
          "streetName": { "type": "string", "minLength": 2, "maxLength": 150 },
          "phoneNumber": { "type": "string", "minLength": 6, "maxLength": 40 }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "status": { "type": "string", "enum": ["PENDING", "PREPARING", "READY_FOR_DELIVERY", "OUT_FOR_DELIVERY", "DELIVERED"] },
          "statusLabel": { "type": "string", "example": "In Progress" },
          "productsTotal": { "type": "number" },
          "deliveryFee": { "type": "number" },
          "total": { "type": "number", "description": "Total order price" },
          "address": { "$ref": "#/components/schemas/DeliveryAddress" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/OrderItemSnapshot" } },
          "chefId": { "type": "integer", "nullable": true },
          "preparedAt": { "type": "string", "format": "date-time", "nullable": true },
          "deliveryId": { "type": "integer", "nullable": true },
          "acceptedAt": { "type": "string", "format": "date-time", "nullable": true },
          "deliveredAt": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CustomerRow": {
        "type": "object",
        "required": ["name", "username", "userCode", "email"],
        "properties": {
          "name": { "type": "string" },
          "username": { "type": "string" },
          "userCode": { "type": "string" },
          "email": { "type": "string" }
        }
      },
      "AdminProduct": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "sku": { "type": "string", "nullable": true },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "price": { "type": "number" },
          "image": { "type": "string", "nullable": true },
          "imageUrl": { "type": "string", "nullable": true },
          "isActive": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "StaffRow": {
        "type": "object",
        "properties": {
          "userCode": { "type": "string" },
          "name": { "type": "string" },
          "username": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string", "enum": ["CHEF", "DELIVERY"] },
          "isActive": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Analytics": {
        "type": "object",
        "properties": {
          "unitsSold": {
            "type": "object",
            "properties": {
              "today": { "type": "integer" },
              "month": { "type": "integer" },
              "year": { "type": "integer" }
            }
          },
          "sales": {
            "type": "object",
            "description": "DELIVERED order totals only",
            "properties": {
              "today": { "type": "number" },
              "month": { "type": "number" },
              "year": { "type": "number" }
            }
          },
          "byProduct": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productId": { "type": "integer" },
                "productName": { "type": "string" },
                "unitsSold": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check (public)",
        "responses": {
          "200": { "description": "API is running" }
        }
      }
    },
    "/api/docs.json": {
      "get": {
        "tags": ["System"],
        "summary": "Machine-readable OpenAPI document (public)",
        "responses": { "200": { "description": "OpenAPI JSON" } }
      }
    },
    "/api/home": {
      "get": {
        "tags": ["Home"],
        "summary": "Home entrypoint (public browse; identity when authenticated)",
        "description": "Public read: no Access Token required for guest browse. Authenticated requests return identity; invalid tokens still return 401. The data object also carries maxQuantity (cart line cap, mirrors server validation).",
        "responses": {
          "200": { "description": "Welcome + identity (guest when unauthenticated) + maxQuantity" },
          "401": { "description": "Invalid access token" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Create account (public, always BASIC)",
        "description": "Public registration. Role cannot be chosen (strict schema rejects role). Does not log the user in; response navigates to login.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "username", "email", "password"],
                "properties": {
                  "name": { "type": "string", "minLength": 2, "maxLength": 120 },
                  "username": { "type": "string", "minLength": 3, "maxLength": 60, "pattern": "^[a-zA-Z0-9._-]+$" },
                  "email": { "type": "string", "format": "email", "maxLength": 190 },
                  "password": { "type": "string", "minLength": 8, "maxLength": 128 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Account created; navigates to login" },
          "400": { "description": "Validation failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "409": { "description": "Username/email taken" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login (public, all roles share this route)",
        "description": "Returns identity + access/refresh tokens. ADMIN logins navigate to the admin dashboard, others to home.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Invalid credentials" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Refresh token rotation (public)",
        "description": "Valid non-revoked refresh token returns a new pair; the presented token is revoked (rotation). Separate secret/expiry from access tokens.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["refreshToken"], "properties": { "refreshToken": { "type": "string" } } } } }
        },
        "responses": {
          "200": { "description": "New token pair" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Invalid/expired/revoked refresh token" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Logout: revoke the presented access token (protected)",
        "description": "Revokes the presented ACCESS token row. Accepts optional refreshToken (revoked only if it belongs to the same user) and optional allSessions flag to revoke every session.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "refreshToken": { "type": "string" }, "allSessions": { "type": "boolean" } } } } }
        },
        "responses": {
          "200": { "description": "Logged out" },
          "401": { "description": "Missing/invalid/revoked access token" }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Forgot password: email a 6-digit OTP (public, generic response)",
        "description": "Always returns the same message whether or not the email exists (anti-enumeration).",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["email"], "properties": { "email": { "type": "string", "format": "email" } } } } }
        },
        "responses": {
          "200": { "description": "Generic confirmation; navigates to OTP verification" },
          "400": { "description": "Validation failed" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/auth/verify-otp": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Verify OTP (public)",
        "description": "Wrong code: 400 with no forward navigation. Correct: returns single-use resetToken and navigates to new password. 10-min expiry, 5 attempts, one-time use.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["email", "otp"], "properties": { "email": { "type": "string", "format": "email" }, "otp": { "type": "string", "pattern": "^\\d{6}$" } } } } }
        },
        "responses": {
          "200": { "description": "Code verified" },
          "400": { "description": "Incorrect/expired code" },
          "429": { "description": "Too many attempts or rate limited" }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Set new password (public)",
        "description": "Hashes and stores the password, consumes the reset token, revokes refresh sessions, navigates to login.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "resetToken", "password", "confirmPassword"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "resetToken": { "type": "string" },
                  "password": { "type": "string", "minLength": 8, "maxLength": 128 },
                  "confirmPassword": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password changed" },
          "400": { "description": "Validation failed or invalid/expired reset request" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": ["Products"],
        "summary": "Menu with optional search and pagination (public)",
        "description": "Active products only. Case-insensitive partial name search; page/limit pagination.",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 } },
          { "name": "search", "in": "query", "schema": { "type": "string", "maxLength": 100 } }
        ],
        "responses": {
          "200": { "description": "Menu items + pagination meta" },
          "400": { "description": "Validation failed" }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Product details with add-to-cart (public)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 }, "description": "Product ID" }],
        "responses": {
          "200": { "description": "Product details" },
          "400": { "description": "Validation failed" },
          "404": { "description": "Product not available" }
        }
      }
    },
    "/api/cart": {
      "get": {
        "tags": ["Cart"],
        "summary": "View own cart (BASIC)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Cart with totals (productsTotal + deliveryFee + totalAmount)" },
          "401": { "description": "Missing/invalid access token" },
          "403": { "description": "Non-BASIC role" }
        }
      }
    },
    "/api/cart/confirm": {
      "post": {
        "tags": ["Cart"],
        "summary": "Confirm order: totals preview, move to delivery address (BASIC)",
        "description": "Preview includes canCheckout (boolean) and activeOrderId (integer id or null), reflecting the single-active-order rule without enforcing it.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Preview + navigation to delivery address" },
          "400": { "description": "Cart is empty" },
          "401": { "description": "Missing/invalid access token" },
          "403": { "description": "Non-BASIC role" }
        }
      }
    },
    "/api/cart/items": {
      "post": {
        "tags": ["Cart"],
        "summary": "Add to cart by product ID (BASIC)",
        "description": "Repeat adds increase quantity (one row per product).",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["productId"],
                "properties": {
                  "productId": { "type": "integer", "minimum": 1 },
                  "quantity": { "type": "integer", "minimum": 1, "maximum": 99, "default": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated cart" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Missing/invalid access token" },
          "403": { "description": "Non-BASIC role" },
          "404": { "description": "Product not available" }
        }
      }
    },
    "/api/cart/items/{productId}": {
      "patch": {
        "tags": ["Cart"],
        "summary": "Increase/decrease/set quantity (BASIC)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "oneOf": [{ "type": "object", "required": ["quantity"], "properties": { "quantity": { "type": "integer", "minimum": 1, "maximum": 99 } } }, { "type": "object", "required": ["action"], "properties": { "action": { "type": "string", "enum": ["increase", "decrease"] } } }] }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated cart" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Missing/invalid access token" },
          "403": { "description": "Non-BASIC role" },
          "404": { "description": "Product not in cart" }
        }
      },
      "delete": {
        "tags": ["Cart"],
        "summary": "Delete a product from the cart (BASIC)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "productId", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }],
        "responses": {
          "200": { "description": "Updated cart" },
          "401": { "description": "Missing/invalid access token" },
          "403": { "description": "Non-BASIC role" },
          "404": { "description": "Product not in cart" }
        }
      }
    },
    "/api/orders/checkout": {
      "post": {
        "tags": ["Orders"],
        "summary": "Delivery address + order creation (BASIC)",
        "description": "Creates the order, snapshots items, clears the cart in one transaction. Single-active-order rule: at most one active (non-DELIVERED) order per BASIC user; checkout while another order is active returns 409 ACTIVE_ORDER_EXISTS. Check POST /api/cart/confirm (canCheckout, activeOrderId) before posting.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeliveryAddress" } } }
        },
        "responses": {
          "201": { "description": "Order confirmed" },
          "400": { "description": "Validation failed, empty cart, or unavailable product" },
          "401": { "description": "Missing/invalid access token" },
          "403": { "description": "Non-BASIC role" },
          "409": { "description": "Active order already exists" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "List own orders, paginated (BASIC)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 } }
        ],
        "responses": {
          "200": { "description": "Own orders + meta" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Missing/invalid access token" },
          "403": { "description": "Non-BASIC role" }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "tags": ["Orders"],
        "summary": "One own order with status (BASIC, read-only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 }, "description": "Order ID" }],
        "responses": {
          "200": { "description": "Order details" },
          "400": { "description": "Validation failed" },
          "401": { "description": "Missing/invalid access token" },
          "403": { "description": "Non-BASIC role" },
          "404": { "description": "Order not found" }
        }
      }
    },
    "/api/chef/requests": {
      "get": {
        "tags": ["CHEF"],
        "summary": "Request orders: PENDING with preparation data (CHEF)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Pending orders oldest first" },
          "401": { "description": "Missing/invalid access token" },
          "403": { "description": "Non-CHEF role" }
        }
      }
    },
    "/api/chef/requests/{id}/prepare": {
      "post": {
        "tags": ["CHEF"],
